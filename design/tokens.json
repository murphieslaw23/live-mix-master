{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "LiveMixMaster Design Tokens",
  "version": "1.0.0-draft",
  "status": "review-required",
  "sourceIssue": "https://github.com/murphieslaw23/live-mix-master/issues/1",
  "colors": {
    "surface/base": "#111315",
    "surface/rack": "#1C1F23",
    "surface/strip": "#24292F",
    "accent/ochre": "#D96528",
    "accent/copper": "#2A7A6D",
    "status/warn": "#D48822",
    "meter/nominal": "#22C55E",
    "meter/headroom": "#EAB308",
    "meter/clip": "#EF4444",
    "meter/inactive": "#1A1D20",
    "text/primary": "#E6EDF3",
    "text/secondary": "#8B949E"
  },
  "meterScaleDbfs": [0, -6, -12, -18, -24, -36, -60],
  "spacingPx": [4, 8, 12, 16, 24, 32],
  "radiusPx": [2, 4, 8],
  "focus": {
    "widthPx": 2,
    "colorToken": "accent/copper",
    "mustRemainVisibleOnDarkSurface": true
  },
  "disabled": {
    "opacity": 0.4,
    "mustRemainSemanticallyLabeled": true
  },
  "interaction": {
    "minimumTargetPx": 44,
    "criticalStateReinforcement": ["icon", "text", "shape", "color"]
  },
  "typography": {
    "roles": ["sectionDisplay", "uiLabel", "body", "numericTelemetry"],
    "fontFamilies": null,
    "status": "font families and exact metrics require final review; do not infer them from generative artwork"
  },
  "constraints": {
    "noGradients": true,
    "noNeon": true,
    "noCyberpunkChrome": true,
    "noTerminalChrome": true,
    "noGlossyStartupCards": true,
    "primaryActionColorToken": "accent/ochre",
    "healthyConnectionColorToken": "accent/copper",
    "warningColorToken": "status/warn",
    "errorOrClipColorToken": "meter/clip"
  }
}
