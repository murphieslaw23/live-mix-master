{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "LiveMixMaster Design Tokens",
  "version": "1.0.0-rc1",
  "status": "visual-qa",
  "sourceIssue": "https://github.com/murphieslaw23/live-mix-master/issues/1",
  "colors": {
    "surface/base": "#111315",
    "surface/rack": "#1C1F23",
    "surface/strip": "#24292F",
    "accent/ochre": "#D96528",
    "accent/copper": "#2A7A6D",
    "status/warn": "#D48822",
    "meter/nominal": "#22C55E",
    "meter/headroom": "#EAB308",
    "meter/clip": "#EF4444",
    "meter/inactive": "#1A1D20",
    "text/primary": "#E6EDF3",
    "text/secondary": "#8B949E"
  },
  "meterScaleDbfs": [0, -6, -12, -18, -24, -36, -60],
  "spacingPx": [4, 8, 12, 16, 24, 32],
  "radiusPx": [2, 4, 8],
  "focus": {
    "widthPx": 2,
    "colorToken": "accent/copper",
    "mustRemainVisibleOnDarkSurface": true,
    "fallbackOnStrip": "text/primary"
  },
  "disabled": {
    "opacity": 0.4,
    "mustRemainSemanticallyLabeled": true
  },
  "interaction": {
    "minimumTargetPx": 44,
    "criticalStateReinforcement": ["icon", "text", "shape", "color"]
  },
  "typography": {
    "bundlingPolicy": "Bundle deterministic font assets with the app; do not depend on runtime font downloads for production or golden tests.",
    "sectionDisplay": {
      "fontFamily": "Roboto Condensed",
      "fontWeight": 700,
      "uppercase": true,
      "fontSizePx": {"desktop": 24, "tablet": 22, "mobile": 20},
      "lineHeight": 1.0,
      "letterSpacingEm": 0.04
    },
    "uiLabel": {
      "fontFamily": "Roboto Condensed",
      "fontWeight": 600,
      "uppercase": true,
      "fontSizePx": {"desktop": 12, "tablet": 12, "mobile": 12},
      "lineHeight": 1.15,
      "letterSpacingEm": 0.06
    },
    "body": {
      "fontFamily": "Inter",
      "fontWeight": 400,
      "fontSizePx": {"desktop": 14, "tablet": 14, "mobile": 14},
      "lineHeight": 1.4,
      "letterSpacingEm": 0.0
    },
    "numericTelemetry": {
      "fontFamily": "Roboto Mono",
      "fontWeight": 600,
      "fontSizePx": {"desktop": 16, "tablet": 16, "mobile": 16},
      "lineHeight": 1.2,
      "tabularFiguresRequired": true
    }
  },
  "contrastPolicy": {
    "target": "WCAG 2.2 AA where applicable; non-text UI boundaries and focus indicators target at least 3:1 against adjacent surfaces.",
    "verifiedRatios": {
      "text/primary on surface/base": 15.76,
      "text/primary on surface/rack": 14.0,
      "text/primary on surface/strip": 12.4,
      "text/secondary on surface/base": 6.05,
      "text/secondary on surface/rack": 5.38,
      "text/secondary on surface/strip": 4.76,
      "accent/copper on surface/base": 3.64,
      "accent/copper on surface/rack": 3.23,
      "accent/copper on surface/strip": 2.86
    },
    "rules": [
      "Use text/primary or text/secondary for readable status copy; do not rely on accent/copper as small text on surface/strip.",
      "Use accent/copper for healthy-state border/icon/shape reinforcement on base or rack surfaces.",
      "If a copper focus ring sits directly on surface/strip, add a text/primary outer edge or move the focused control onto rack/base so the focus indicator remains at least 3:1.",
      "Red, amber, green and yellow state colors never replace the required icon + text + shape semantics."
    ]
  },
  "constraints": {
    "noGradients": true,
    "noNeon": true,
    "noCyberpunkChrome": true,
    "noTerminalChrome": true,
    "noGlossyStartupCards": true,
    "primaryActionColorToken": "accent/ochre",
    "healthyConnectionColorToken": "accent/copper",
    "warningColorToken": "status/warn",
    "errorOrClipColorToken": "meter/clip"
  }
}
